<Window x:Class="MagicMouse.Windows.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:MagicMouse.Windows.App" Title="Magic Mouse for Windows">
 <local:CursorSurface x:Name="RootGrid" RequestedTheme="Light" Background="{ThemeResource CanvasBrush}">
  <Grid.ColumnDefinitions><ColumnDefinition Width="224"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="{ThemeResource SidebarBrush}" BorderBrush="{ThemeResource ShellStrokeBrush}" BorderThickness="0,0,1,0">
   <Grid Padding="12,0,12,16">
    <Grid.RowDefinitions><RowDefinition Height="52"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="8,0,0,0">
     <Button x:Name="CloseWindowButton" Style="{StaticResource TrafficLightButton}" Background="#FF5F57" AutomationProperties.Name="Cerrar" ToolTipService.ToolTip="Cerrar"><TextBlock Text="×" Opacity="0"/></Button>
     <Button x:Name="MinimizeWindowButton" Style="{StaticResource TrafficLightButton}" Background="#FEBC2E" AutomationProperties.Name="Minimizar" ToolTipService.ToolTip="Minimizar"><TextBlock Text="−" Opacity="0"/></Button>
     <Button x:Name="MaximizeWindowButton" Style="{StaticResource TrafficLightButton}" Background="#28C840" AutomationProperties.Name="Ampliar o restaurar" ToolTipService.ToolTip="Ampliar o restaurar"><TextBlock Text="+" Opacity="0"/></Button>
    </StackPanel>
    <TextBox x:Name="NavigationSearch" Grid.Row="1" PlaceholderText="Buscar" Margin="4,2,4,18" MinHeight="30" FontSize="12" CornerRadius="8" Background="{ThemeResource ControlSurfaceBrush}" BorderBrush="{ThemeResource ShellStrokeBrush}" AutomationProperties.Name="Buscar configuración"/>
    <Button x:Name="BrandButton" Grid.Row="2" Background="Transparent" BorderThickness="0" Padding="8,0,8,0" Margin="0,0,0,20" HorizontalContentAlignment="Left" AutomationProperties.Name="Acerca de Magic Mouse for Windows" ToolTipService.ToolTip="Conoce al creador">
    <StackPanel Orientation="Horizontal" Spacing="10" Margin="0">
     <Border Width="34" Height="38" CornerRadius="10" Background="{ThemeResource CardSurfaceBrush}"><Image Source="ms-appx:///Assets/MagicMouse.png" Stretch="Uniform" AutomationProperties.Name="Magic Mouse"/></Border>
     <StackPanel VerticalAlignment="Center"><TextBlock Text="Magic Mouse" FontSize="14" FontWeight="SemiBold"/><TextBlock Text="for Windows" FontSize="11" Foreground="{ThemeResource SecondaryTextBrush}"/></StackPanel>
    </StackPanel>
    </Button>
    <StackPanel x:Name="NavigationPanel" Grid.Row="3" Spacing="3"/>
    <StackPanel Grid.Row="4" Spacing="8" Margin="4,0,4,0">
     <Border x:Name="DeviceBadge" Background="{ThemeResource DeviceGlassSurfaceBrush}" BorderBrush="{ThemeResource DeviceGlassEdgeBrush}" BorderThickness="1" CornerRadius="16" Padding="12">
      <StackPanel Spacing="7"><TextBlock x:Name="DeviceStatusText" Text="Buscando dispositivos…" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock x:Name="DeviceDetailText" Text="Sin datos de hardware todavía" FontSize="11" Foreground="{ThemeResource SecondaryTextBrush}" TextWrapping="Wrap"/>
       <StackPanel Orientation="Horizontal" Spacing="6"><Button x:Name="RetryDeviceButton" Content="Reintentar" FontSize="11" Padding="8,4"/><Button x:Name="BluetoothSettingsButton" Content="Bluetooth" FontSize="11" Padding="8,4"/></StackPanel>
      </StackPanel>
     </Border>

    </StackPanel>
   </Grid>
  </Border>
  <Grid Grid.Column="1">
   <Grid.RowDefinitions><RowDefinition Height="52"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <Border BorderBrush="{ThemeResource ShellStrokeBrush}" BorderThickness="0,0,0,1" Background="{ThemeResource CardSurfaceBrush}">
    <Grid>
     <Border x:Name="WindowDragArea" Background="Transparent" Margin="82,0,150,0"/>
     <StackPanel Orientation="Horizontal" Spacing="4" Margin="16,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left">
      <Button x:Name="BackNavigationButton" Content="‹" FontSize="23" Width="25" Height="28" Padding="0" Background="Transparent" BorderThickness="0" AutomationProperties.Name="Volver"/>
      <Border Width="1" Height="18" Background="{ThemeResource ShellStrokeBrush}"/>
      <Button x:Name="ForwardNavigationButton" Content="›" FontSize="23" Width="25" Height="28" Padding="0" Background="Transparent" BorderThickness="0" AutomationProperties.Name="Adelante"/>
     </StackPanel>
     <TextBlock x:Name="PageTitle" Text="Aspecto" FontSize="14" FontWeight="SemiBold" Margin="98,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
     <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,18,0">
      <Button x:Name="PageInfoButton" Width="28" Height="28" Padding="0" VerticalAlignment="Center" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Background="Transparent" BorderThickness="0" AutomationProperties.Name="Información de esta página"><FontIcon Glyph="&#xE946;" FontSize="14"/></Button>
      <Button x:Name="BatteryButton" Background="Transparent" BorderThickness="0" Padding="2" AutomationProperties.Name="Batería del Magic Mouse">
       <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
        <TextBlock x:Name="BatteryPercentage" Text="—" MinWidth="32" FontSize="11" Foreground="{ThemeResource SecondaryTextBrush}" VerticalAlignment="Center"/>
        <Viewbox Width="32" Height="18" Stretch="Uniform"><Grid Width="54" Height="30">
         <Border Width="46" Height="25" CornerRadius="7" BorderThickness="2" BorderBrush="{ThemeResource TextBrush}" HorizontalAlignment="Left" VerticalAlignment="Center"/>
         <Border x:Name="BatteryFill" Width="36" Height="15" CornerRadius="3.5" Background="{ThemeResource TextBrush}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="5,0,0,0"/>
         <Border Width="4" Height="9" CornerRadius="0,4,4,0" Background="{ThemeResource TextBrush}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="48,0,0,0"/>
         <TextBlock x:Name="BatteryUnknown" Text="?" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource SecondaryTextBrush}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="19,0,0,0"/>
         <Path x:Name="BatteryBolt" Data="M28,0 L16,15 L24,15 L18,29 L34,11 L26,11 Z" Fill="{ThemeResource TextBrush}" Stroke="{ThemeResource CanvasBrush}" StrokeThickness="2.5" StrokeLineJoin="Round" Visibility="Collapsed"/>
        </Grid></Viewbox>

       </StackPanel>
      </Button>
     </StackPanel>
    </Grid>
   </Border>
   <ScrollViewer x:Name="ContentScrollViewer" Grid.Row="1" VerticalScrollBarVisibility="Auto">
    <StackPanel Padding="24,22,24,24" Spacing="18"><TextBlock x:Name="PageSubtitle" FontSize="12" Foreground="{ThemeResource SecondaryTextBrush}" TextWrapping="Wrap"/><StackPanel x:Name="PageContent" Spacing="18"/></StackPanel>
   </ScrollViewer>
  </Grid>
  <Border x:Name="ModalScrim" Grid.ColumnSpan="2" Background="#77000000" Visibility="Collapsed">
   <Border x:Name="ModalCard" Background="{ThemeResource CardSurfaceBrush}" CornerRadius="26" Padding="28" MaxWidth="640" Margin="32" HorizontalAlignment="Stretch" VerticalAlignment="Center" BorderBrush="{ThemeResource ShellStrokeBrush}" BorderThickness="1">
    <StackPanel Spacing="20"><TextBlock x:Name="ModalTitle" FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap"/>
     <Border x:Name="ModalHero" Background="{ThemeResource HeroSurfaceBrush}" CornerRadius="18" Padding="18" Visibility="Collapsed"><Image Source="ms-appx:///Assets/MagicMouse.png" Height="180" Stretch="Uniform"/></Border>
     <TextBlock x:Name="ModalMessage" FontSize="13" Foreground="{ThemeResource SecondaryTextBrush}" TextWrapping="Wrap"/>
     <Grid><Button x:Name="ModalCancelButton" Content="Cancelar" HorizontalAlignment="Left"/><Button x:Name="ModalAcceptButton" Content="Entendido" Style="{StaticResource AccentButtonStyle}" Background="#007AFF" Foreground="White" HorizontalAlignment="Right"/></Grid>
    </StackPanel>
   </Border>
  </Border>
 </local:CursorSurface>
</Window>
