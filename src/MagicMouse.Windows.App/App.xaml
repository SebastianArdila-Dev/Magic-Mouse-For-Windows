<Application
    x:Class="MagicMouse.Windows.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <LinearGradientBrush x:Key="DeviceGlassSurfaceBrush" StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#BFFFFFFF" Offset="0"/><GradientStop Color="#55FFFFFF" Offset="0.55"/><GradientStop Color="#88F4F7FF" Offset="1"/></LinearGradientBrush>
                    <LinearGradientBrush x:Key="DeviceGlassEdgeBrush" StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#EEFFFFFF" Offset="0"/><GradientStop Color="#779FAABD" Offset="0.5"/><GradientStop Color="#BBFFFFFF" Offset="1"/></LinearGradientBrush>
                    <SolidColorBrush x:Key="AccentBrush" Color="#1683FF" /><SolidColorBrush x:Key="SidebarBrush" Color="#E9EAEF"/><SolidColorBrush x:Key="ShellStrokeBrush" Color="#DCDCE3"/><SolidColorBrush x:Key="ControlSurfaceBrush" Color="#F0F0F3"/><SolidColorBrush x:Key="CardSurfaceBrush" Color="#FCFCFD"/><SolidColorBrush x:Key="HeroSurfaceBrush" Color="#F4F4F7"/>
                    <SolidColorBrush x:Key="CanvasBrush" Color="#F8F8FA" />
                    <SolidColorBrush x:Key="CardBrush" Color="#DFFFFFFF" />
                    <SolidColorBrush x:Key="CardStrokeBrush" Color="#BFFFFFFF" />
                    <SolidColorBrush x:Key="TextBrush" Color="#101827" />
                    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#69778D" />
                    <SolidColorBrush x:Key="SliderTrackValueFill" Color="#007AFF" />
                    <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="#007AFF" />
                    <SolidColorBrush x:Key="SliderTrackValueFillPressed" Color="#007AFF" />
                    <SolidColorBrush x:Key="SliderThumbBackground" Color="#007AFF" />
                    <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="#007AFF" />
                    <SolidColorBrush x:Key="SliderThumbBackgroundPressed" Color="#007AFF" />
                    <SolidColorBrush x:Key="AccentButtonBackground" Color="#007AFF" />
                </ResourceDictionary>
                            <ResourceDictionary x:Key="Dark">
                    <LinearGradientBrush x:Key="DeviceGlassSurfaceBrush" StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#553F414B" Offset="0"/><GradientStop Color="#223F414B" Offset="0.55"/><GradientStop Color="#4432343E" Offset="1"/></LinearGradientBrush>
                    <LinearGradientBrush x:Key="DeviceGlassEdgeBrush" StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#66FFFFFF" Offset="0"/><GradientStop Color="#227F899B" Offset="0.5"/><GradientStop Color="#44FFFFFF" Offset="1"/></LinearGradientBrush>
                    <SolidColorBrush x:Key="AccentBrush" Color="#007AFF"/>
                    <SolidColorBrush x:Key="CanvasBrush" Color="#1F1F23"/>
                    <SolidColorBrush x:Key="TextBrush" Color="#F1F1F4"/>
                    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#A8A8B7"/>
                    <SolidColorBrush x:Key="SidebarBrush" Color="#29292F"/>
                    <SolidColorBrush x:Key="ShellStrokeBrush" Color="#414149"/>
                    <SolidColorBrush x:Key="ControlSurfaceBrush" Color="#36363D"/>
                    <SolidColorBrush x:Key="CardSurfaceBrush" Color="#29292E"/>
                    <SolidColorBrush x:Key="HeroSurfaceBrush" Color="#202026"/>
                    <SolidColorBrush x:Key="SliderTrackValueFill" Color="#007AFF"/>
                    <SolidColorBrush x:Key="SliderThumbBackground" Color="#FFFFFF"/>
                </ResourceDictionary></ResourceDictionary.ThemeDictionaries>
            <x:Double x:Key="RadiusSmall">10</x:Double>
            <x:Double x:Key="RadiusMedium">18</x:Double>
            <x:Double x:Key="RadiusLarge">26</x:Double>
            <x:Double x:Key="SpaceSmall">8</x:Double>
            <x:Double x:Key="SpaceMedium">16</x:Double>
            <x:Double x:Key="SpaceLarge">24</x:Double>

            <Style x:Key="ColorSwatchButton" TargetType="Button">
                <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                    <Grid Background="Transparent"><ContentPresenter Content="{TemplateBinding Content}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid>
                </ControlTemplate></Setter.Value></Setter>
            </Style>

            <Style x:Key="TrafficLightButton" TargetType="Button">
                <Setter Property="Width" Value="13"/><Setter Property="Height" Value="13"/>
                <Setter Property="MinWidth" Value="13"/><Setter Property="MinHeight" Value="13"/>
                <Setter Property="Padding" Value="0"/><Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                    <Border x:Name="Dot" Background="{TemplateBinding Background}" CornerRadius="7">
                        <VisualStateManager.VisualStateGroups><VisualStateGroup x:Name="CommonStates">
                            <VisualState x:Name="Normal"/><VisualState x:Name="PointerOver"><VisualState.Setters><Setter Target="Dot.Opacity" Value="0.78"/></VisualState.Setters></VisualState>
                            <VisualState x:Name="Pressed"><VisualState.Setters><Setter Target="Dot.Opacity" Value="0.6"/></VisualState.Setters></VisualState>
                            <VisualState x:Name="Disabled"><VisualState.Setters><Setter Target="Dot.Opacity" Value="0.4"/></VisualState.Setters></VisualState>
                        </VisualStateGroup></VisualStateManager.VisualStateGroups>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Content="{TemplateBinding Content}"/>
                    </Border>
                </ControlTemplate></Setter.Value></Setter>
            </Style>

                    <SolidColorBrush x:Key="ToggleSwitchFillOff" Color="#C8C8CD"/>
                    <SolidColorBrush x:Key="ToggleSwitchStrokeOff" Color="Transparent"/>
                    <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="#007AFF"/>
                    <SolidColorBrush x:Key="ToggleSwitchStrokeOn" Color="Transparent"/>
                    <SolidColorBrush x:Key="ToggleSwitchKnobFillOff" Color="White"/>
                    <SolidColorBrush x:Key="ToggleSwitchKnobFillOn" Color="White"/>

            <Style x:Key="CompactSwitch" TargetType="ToggleSwitch">
                <Setter Property="MinWidth" Value="0"/><Setter Property="Width" Value="52"/><Setter Property="MinHeight" Value="28"/>

                <Setter Property="OnContent" Value=""/><Setter Property="OffContent" Value=""/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
            <Style TargetType="Button"><Setter Property="FontFamily" Value="ms-appx:///Assets/Fonts/InterVariable.ttf#Inter Variable"/><Setter Property="CornerRadius" Value="7"/><Setter Property="FontSize" Value="12"/><Setter Property="MinHeight" Value="28"/><Setter Property="Padding" Value="12,5"/><Setter Property="Background" Value="{ThemeResource ControlSurfaceBrush}"/><Setter Property="BorderBrush" Value="{ThemeResource ShellStrokeBrush}"/></Style>
            <Style TargetType="ComboBox"><Setter Property="FontFamily" Value="ms-appx:///Assets/Fonts/InterVariable.ttf#Inter Variable"/><Setter Property="CornerRadius" Value="7"/><Setter Property="MinHeight" Value="30"/><Setter Property="FontSize" Value="12"/><Setter Property="Background" Value="{ThemeResource CardSurfaceBrush}"/><Setter Property="BorderBrush" Value="{ThemeResource ShellStrokeBrush}"/></Style><Style TargetType="TextBlock"><Setter Property="FontFamily" Value="ms-appx:///Assets/Fonts/InterVariable.ttf#Inter Variable"/></Style></ResourceDictionary>
    </Application.Resources>
</Application>
